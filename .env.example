# .env — local development only, DO NOT COMMIT
DATABASE_URL=postgres://sayangcare:changeme@localhost:5433/sayangcare

# App config (nested via __ separator)
POSTGRES_PASSWORD=changeme
SAYANGCARE__POSTGRES__URL=postgres://sayangcare:changeme@localhost:5433/sayangcare
SAYANGCARE__POSTGRES__MAX_CONNECTIONS=20

SAYANGCARE__REDIS__SENTINEL_ENDPOINTS=127.0.0.1:26379
SAYANGCARE__REDIS__MASTER_NAME=sayangcare-master
SAYANGCARE__REDIS__MASTER_URL=redis://127.0.0.1:6379/
SAYANGCARE__REDIS__QUEUE_URL=redis://127.0.0.1:6379/

SAYANGCARE__SERVER__HOST=0.0.0.0
SAYANGCARE__SERVER__PORT=8080
SAYANGCARE__SERVER__WORKERS=4

SAYANGCARE__CIRCUIT_BREAKER__BASE_ERROR_RATE=0.25
SAYANGCARE__CIRCUIT_BREAKER__BASE_LATENCY_MS=2000
SAYANGCARE__CIRCUIT_BREAKER__MIN_REQUESTS=20
SAYANGCARE__CIRCUIT_BREAKER__HALF_OPEN_AFTER_SECS=10

SAYANGCARE__TELEPHONY__TWILIO_ACCOUNT_SID=ACtest
SAYANGCARE__TELEPHONY__TWILIO_AUTH_TOKEN=test
SAYANGCARE__TELEPHONY__PUBLIC_BASE_URL=http://localhost:8080

RUST_LOG=info,sayangcare=debug,actix_web=info