# .env â€” local development only, DO NOT COMMIT
POSTGRES_PORT=5434
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://sayangcare:changeme@127.0.0.1:5434/sayangcare

# App config (nested via __ separator)
SAYANGCARE__POSTGRES__URL=postgres://sayangcare:changeme@127.0.0.1:5434/sayangcare
SAYANGCARE__POSTGRES__MAX_CONNECTIONS=20

SAYANGCARE__REDIS__SENTINEL_ENDPOINTS=127.0.0.1:26379
SAYANGCARE__REDIS__MASTER_NAME=sayangcare-master
SAYANGCARE__REDIS__MASTER_URL=redis://127.0.0.1:6379/

SAYANGCARE__SERVER__HOST=0.0.0.0
SAYANGCARE__SERVER__PORT=8081
SAYANGCARE__SERVER__WORKERS=4

# Volunteer queue backend: "redis" (default) or "raft" (OpenRaft cluster).
# SAYANGCARE__QUEUE__BACKEND=raft
# SAYANGCARE__QUEUE__RAFT_NODE_ID=1
# SAYANGCARE__QUEUE__RAFT_PEERS=1=http://127.0.0.1:8081,2=http://127.0.0.1:8082,3=http://127.0.0.1:8083
# SAYANGCARE__QUEUE__RAFT_TOKEN=change-me
# SAYANGCARE__QUEUE__RAFT_DATA_DIR=./data/raft

SAYANGCARE__CIRCUIT_BREAKER__BASE_ERROR_RATE=0.25
SAYANGCARE__CIRCUIT_BREAKER__BASE_LATENCY_MS=2000
SAYANGCARE__CIRCUIT_BREAKER__MIN_REQUESTS=20
SAYANGCARE__CIRCUIT_BREAKER__HALF_OPEN_AFTER_SECS=10

# Optional Groq inference. Put the key only in your ignored local .env.
# SAYANGCARE__AI__API_KEY=
SAYANGCARE__AI__MODEL=openai/gpt-oss-120b
SAYANGCARE__AI__BASE_URL=https://api.groq.com/openai/v1/chat/completions
SAYANGCARE__AI__TIMEOUT_SECS=12

SAYANGCARE__TELEPHONY__TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SAYANGCARE__TELEPHONY__TWILIO_AUTH_TOKEN=your_twilio_auth_token
# A Twilio-owned/verified caller ID used for outbound volunteer dispatch.
SAYANGCARE__TELEPHONY__TWILIO_FROM_NUMBER=+17372508034
SAYANGCARE__TELEPHONY__PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.dev

RUST_LOG=info,sayangcare=debug,actix_web=info

# Caller-turn guardrails; shared by JSON turns and Twilio gather.
SAYANGCARE__PERFORMANCE__RESPONSE_BUDGET_MS=5000
SAYANGCARE__PERFORMANCE__PERSISTENCE_RESERVE_MS=1000
SAYANGCARE__PERFORMANCE__SENTIMENT_TIMEOUT_MS=800
SAYANGCARE__PERFORMANCE__REPLY_TIMEOUT_MS=3000
SAYANGCARE__PERFORMANCE__COORDINATION_TIMEOUT_MS=200
# Per API process, shared across all Actix workers. HPA multiplies cluster capacity.
SAYANGCARE__PERFORMANCE__MAX_AI_TURNS=8

SAYANGCARE__AI__API_KEY= <ENTER SECRET API KEY HERE>
SAYANGCARE__AI__MODEL=openai/gpt-oss-20b
SAYANGCARE__AI__BASE_URL=https://api.groq.com/openai/v1/chat/completions